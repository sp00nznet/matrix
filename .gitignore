# --- Original retail files: NOT redistributed in this repo ---
# The Matrix Online (c) 2005 Warner Bros. / Monolith / SEGA / SOE. In copyright.
# Bring your own discs and drop them in original/; the pipeline unpacks them
# into disc/ and game/ itself. None of it is ours to ship.
original/
disc/
game/
game_final/
client/
# Any unpacked client, however the folder is spelled.
game*/

# Generated lifted C: a derivative work of client.dll, and millions of lines.
# Patterned: a second target means a second output dir, and lifted C is a
# derivative work that must never be tracked under any spelling.
src/recomp/gen*/

# Build artifacts
build/
out/
cmake-build-*/
*.obj
*.o
*.lib
*.pdb
*.ilk
*.exp
*.a

# IDE
.vs/
.vscode/
*.user
*.suo
CMakeSettings.json
CMakeUserPresets.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Scratch / regeneratable output
work/
gen/
*.asm
*.json.bak
# disasm32's raw catalogs: huge, per-target, and regenerated by a pipeline run.
# Patterned rather than listed by name -- the list version covered
# analysis/functions.json but not analysis/final_functions.json, and the second
# target's 25 MB output would have been committed the moment it finished.
analysis/*disasm.log
analysis/functions.json
analysis/*_functions.json

# Belt and braces: no game material by extension, anywhere.
*.iso
*.ISO
*.cab
*.CAB
*.pkb
*.ltb
*.exe
*.EXE
*.dll
*.DLL
*.bin
*.cue
*.img

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Generated by gen_imports.py from the binary's import table; regenerates in
# seconds. Tracked tooling, untracked output -- same rule as the lift.
src/runtime/imports_gen*.c
# Likewise generated, by tools/find_interfaces.py.
src/runtime/interfaces_gen*.c
# Copied from ../tools/runtime/recomp32/ at build time, not ours to fork.
src/runtime/recomp_types.h
# Copied from ../tools/runtime/recomp32/ at build time, not ours to fork.
src/runtime/image_loader.c
src/runtime/image_loader.h
src/runtime/recomp_trace.c
src/runtime/recomp_trace.h
src/runtime/_*_active.c
